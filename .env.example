# Copy to .env.local and fill in. Never commit real values.
#
# Only variables prefixed NEXT_PUBLIC_ are sent to the browser.
# Everything else stays on the server. Never add NEXT_PUBLIC_ to a secret.

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------------
# Public: project URL and publishable (anon) key, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# SERVER ONLY: bypasses Row Level Security. Use only in server code.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Stripe (not used until checkout is built) --------------------------
# Public
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
# SERVER ONLY
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
